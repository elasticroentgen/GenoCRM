<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
        <ProjectReference Include="..\GenoCRM.Client\GenoCRM.Client.csproj" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.14" />
        
        <!-- Entity Framework Core -->
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.14" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" />
        
        <!-- Authentication -->
        <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.14" />
        
        <!-- PDF Generation -->
        <PackageReference Include="QuestPDF" Version="2026.9.1" />
        
        <!-- Excel/CSV Export -->
        <PackageReference Include="EPPlus" Version="8.7.2" />
        <PackageReference Include="CsvHelper" Version="33.1.0" />
        
        <!-- WebDAV Client -->
        <PackageReference Include="WebDAVClient" Version="2.7.0" />
        
        <!-- Validation -->
        <PackageReference Include="FluentValidation" Version="12.2.0" />
        <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
        
        <!-- Logging -->
        <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
        <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
        
        <!-- Environment Variables -->
        <PackageReference Include="DotNetEnv" Version="3.2.0" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="..\..\.dockerignore">
        <Link>.dockerignore</Link>
      </Content>
      <Content Update="Config\group-permissions.json">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <EmbeddedResource Include="Resources\Banking\blz.txt" />
    </ItemGroup>

</Project>
