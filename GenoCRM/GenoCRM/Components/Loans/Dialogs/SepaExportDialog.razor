@using GenoCRM.Models.Domain
@using GenoCRM.Services.Business
@using GenoCRM.Services.Localization
@inject ISepaExportService SepaExport
@inject ILoanPayoutNotificationService PayoutNotificationService
@inject IStringLocalizer<GenoCRM.SharedResource> L
@inject IFormattingService FormattingService
@inject IJSRuntime JS

@{
    var candidates = GetExportCandidates();
    var previousExports = GetPreviousExports();
    var notifications = _redownload ? Array.Empty<LoanPayoutNotification>() : BuildPreview(candidates);
    var mailCount = notifications.Count(n => n.HasEmail);
    var reexportCount = candidates.Count(e => e.ExportedAt.HasValue);
}

<div class="modal fade show d-block" tabindex="-1" role="dialog" style="background: rgba(0,0,0,0.5)">
    <div class="modal-dialog modal-lg modal-dialog-scrollable" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-university me-2"></i>@L["SepaExportTitle"] @Year
                </h5>
                <button type="button" class="btn-close" @onclick="Close" disabled="@_isProcessing"></button>
            </div>
            <div class="modal-body">
                @if (_result != null)
                {
                    @* Result view after export / re-download *@
                    @foreach (var line in _result.Lines)
                    {
                        <div class="alert alert-@line.Level py-2">
                            <i class="fas @(line.Level == "danger" ? "fa-exclamation-triangle" : line.Level == "warning" ? "fa-info-circle" : "fa-check-circle") me-1"></i>
                            @line.Text
                        </div>
                    }
                }
                else if (!SepaExport.Debtor.IsConfigured)
                {
                    <div class="alert alert-warning mb-0">
                        <i class="fas fa-exclamation-triangle"></i> @L["SepaDebtorNotConfigured"]
                    </div>
                }
                else
                {
                    <p class="mb-3">
                        <strong>@L["SepaDebtorAccount"]:</strong>
                        @SepaExport.Debtor.Name · @SepaExport.Debtor.Iban
                        @if (!string.IsNullOrWhiteSpace(SepaExport.Debtor.Bic))
                        {
                            <span> · @SepaExport.Debtor.Bic</span>
                        }
                    </p>

                    <div class="mb-3">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" id="sepaModeExport" name="sepaExportMode"
                                   checked="@(!_redownload)" @onchange="() => SetMode(false)" disabled="@_isProcessing" />
                            <label class="form-check-label" for="sepaModeExport">
                                <strong>@L["SepaModeExport"]</strong>
                                <small class="text-muted d-block">@L["SepaModeExportHint"]</small>
                            </label>
                        </div>
                        <div class="form-check mt-1">
                            <input class="form-check-input" type="radio" id="sepaModeRedownload" name="sepaExportMode"
                                   checked="@_redownload" @onchange="() => SetMode(true)" disabled="@_isProcessing" />
                            <label class="form-check-label" for="sepaModeRedownload">
                                <strong>@L["SepaModeRedownload"]</strong>
                                <small class="text-muted d-block">@L["SepaModeRedownloadHint"]</small>
                            </label>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label">@L["SepaExecutionDate"]</label>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" id="sepaExecDue" name="sepaExecMode"
                                       checked="@(!_useFixedExecutionDate)" @onchange="() => _useFixedExecutionDate = false" />
                                <label class="form-check-label" for="sepaExecDue">@L["SepaExecutionDateDue"]</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" id="sepaExecFixed" name="sepaExecMode"
                                       checked="@_useFixedExecutionDate" @onchange="() => _useFixedExecutionDate = true" />
                                <label class="form-check-label" for="sepaExecFixed">@L["SepaExecutionDateFixed"]</label>
                            </div>
                            @if (_useFixedExecutionDate)
                            {
                                <input type="date" class="form-control mt-1" @bind="_fixedExecutionDate" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                            }
                        </div>
                        <div class="col-md-6">
                            @if (_redownload)
                            {
                                <label class="form-label" for="sepaRedownloadRef">@L["SepaRedownloadSelect"]</label>
                                @if (previousExports.Count == 0)
                                {
                                    <div class="text-muted small">@L["SepaNoPreviousExports"]</div>
                                }
                                else
                                {
                                    <select id="sepaRedownloadRef" class="form-select" @bind="_redownloadReference">
                                        @foreach (var export in previousExports)
                                        {
                                            <option value="@export.Reference">
                                                @FormattingService.FormatDate(export.ExportedAt) · @export.Reference ·
                                                @export.Count @L["Payments"] · @FormattingService.FormatCurrency(export.Sum)
                                            </option>
                                        }
                                    </select>
                                }
                            }
                            else
                            {
                                <div class="form-check mt-md-4">
                                    <input class="form-check-input" type="checkbox" id="sepaIncludeExported"
                                           checked="@_includeExported" @onchange="e => SetIncludeExported((bool)e.Value!)" />
                                    <label class="form-check-label" for="sepaIncludeExported">@L["SepaIncludeExported"]</label>
                                </div>
                            }
                        </div>
                    </div>

                    @if (!_redownload)
                    {
                        <p class="mb-2">
                            <strong>@candidates.Count</strong> @L["Payments"] ·
                            <strong>@FormattingService.FormatCurrency(candidates.Sum(e => e.TotalAmount))</strong> ·
                            <strong>@notifications.Count</strong> @L["Members"]
                        </p>

                        @if (candidates.Count > 0)
                        {
                            <div class="alert alert-warning">
                                <i class="fas fa-envelope"></i>
                                <strong>@string.Format(L["SepaConfirmMailWarning"], mailCount)</strong>
                                <div class="small mt-1">@L["SepaConfirmMailWarningDetail"]</div>
                            </div>

                            @if (reexportCount > 0)
                            {
                                <div class="alert alert-danger py-2 small">
                                    <i class="fas fa-exclamation-triangle"></i> @string.Format(L["SepaConfirmReexportWarning"], reexportCount)
                                </div>
                            }

                            <div class="border rounded mb-2" style="max-height: 14rem; overflow-y: auto;">
                                <table class="table table-sm mb-0">
                                    <thead class="table-light" style="position: sticky; top: 0;">
                                        <tr>
                                            <th>@L["Member"]</th>
                                            <th>@L["Email"]</th>
                                            <th class="text-end">@L["Payments"]</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var n in notifications)
                                        {
                                            <tr class="@(n.HasEmail ? "" : "table-warning")">
                                                <td>@n.Member.FullName</td>
                                                <td>@(n.HasEmail ? n.Member.Email : L["SepaConfirmNoEmail"])</td>
                                                <td class="text-end">@n.Entries.Count</td>
                                                <td class="text-end">
                                                    <button class="btn btn-sm btn-link p-0" @onclick="() => _previewMemberId = n.Member.Id"
                                                            title="@L["SepaConfirmPreview"]">
                                                        <i class="fas fa-eye"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            @if (notifications.Any(n => !n.HasEmail))
                            {
                                <div class="small text-muted mb-2">
                                    <i class="fas fa-info-circle"></i> @string.Format(L["SepaConfirmWithoutEmail"], notifications.Count(n => !n.HasEmail))
                                </div>
                            }

                            @if (notifications.FirstOrDefault(n => n.Member.Id == _previewMemberId) is { } preview)
                            {
                                <div class="border rounded p-2 mb-2 bg-body-tertiary">
                                    <div class="d-flex justify-content-between small mb-1">
                                        <span><strong>@L["SepaConfirmPreview"]:</strong> @preview.Subject</span>
                                        <button class="btn-close btn-sm" @onclick="() => _previewMemberId = null" aria-label="Close"></button>
                                    </div>
                                    <div class="bg-white text-dark p-2 rounded" style="max-height: 18rem; overflow-y: auto;">
                                        @((MarkupString)preview.HtmlBody)
                                    </div>
                                </div>
                            }

                            <div class="form-check mt-3">
                                <input class="form-check-input" type="checkbox" id="sepaConfirmMails" @bind="_confirmed" disabled="@_isProcessing" />
                                <label class="form-check-label" for="sepaConfirmMails">
                                    <strong>@string.Format(L["SepaConfirmCheckbox"], candidates.Count, mailCount)</strong>
                                </label>
                            </div>
                        }
                    }

                    @if (_error != null)
                    {
                        <div class="alert alert-danger mt-3 mb-0">
                            <i class="fas fa-exclamation-triangle"></i> @_error
                        </div>
                    }

                    <small class="text-muted d-block mt-3">@L["SepaExportHint"]</small>
                }
            </div>
            <div class="modal-footer">
                @if (_result != null)
                {
                    <button type="button" class="btn btn-primary" @onclick="Close">@L["Close"]</button>
                }
                else
                {
                    @if (_processingStatus != null)
                    {
                        <span class="small text-muted me-auto">@_processingStatus</span>
                    }
                    <button type="button" class="btn btn-secondary" @onclick="Close" disabled="@_isProcessing">@L["Cancel"]</button>
                    @if (_redownload)
                    {
                        <button type="button" class="btn btn-outline-primary" @onclick="Redownload"
                                disabled="@(_isProcessing || !SepaExport.Debtor.IsConfigured || string.IsNullOrEmpty(_redownloadReference))">
                            @if (_isProcessing)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            <i class="fas fa-download"></i> @L["SepaRedownloadButton"]
                        </button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-primary" @onclick="RequestExport"
                                disabled="@(_isProcessing || !SepaExport.Debtor.IsConfigured || candidates.Count == 0 || !_confirmed)">
                            @if (_isProcessing)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            <i class="fas fa-paper-plane"></i> @string.Format(L["SepaConfirmButton"], mailCount)
                        </button>
                    }
                }
            </div>
        </div>
    </div>
</div>

@if (_showReexportConfirmation)
{
    @* Second confirmation, only when already exported payments would be exported (and paid) again *@
    <div class="modal fade show d-block" tabindex="-1" role="dialog" style="background: rgba(0,0,0,0.5); z-index: 1065;">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content border-danger border-2">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">
                        <i class="fas fa-exclamation-triangle me-2"></i>@L["SepaConfirmTitle"]
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => _showReexportConfirmation = false"></button>
                </div>
                <div class="modal-body">
                    <p class="fw-bold">@string.Format(L["SepaConfirmReexportWarning"], reexportCount)</p>
                    <p class="mb-0">@string.Format(L["SepaConfirmMailWarning"], mailCount)</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="() => _showReexportConfirmation = false">@L["Cancel"]</button>
                    <button type="button" class="btn btn-danger" disabled="@_isProcessing" @onclick="ConfirmReexport">
                        @string.Format(L["SepaConfirmButton"], mailCount)
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    /// <summary>Selected year on the dashboard (only used for the title).</summary>
    [Parameter] public int Year { get; set; }

    /// <summary>Payment plan entries of the selected year, as loaded by the dashboard.</summary>
    [Parameter] public IReadOnlyList<LoanPaymentPlanEntry> Entries { get; set; } = Array.Empty<LoanPaymentPlanEntry>();

    [Parameter] public EventCallback OnCancel { get; set; }

    /// <summary>Raised when the dialog is closed after an export changed data, so the dashboard can reload.</summary>
    [Parameter] public EventCallback OnComplete { get; set; }

    private bool _redownload;
    private bool _includeExported;
    private bool _useFixedExecutionDate;
    private DateTime _fixedExecutionDate = DateTime.Today.AddDays(1);
    private string? _redownloadReference;
    private bool _confirmed;
    private bool _showReexportConfirmation;
    private bool _isProcessing;
    private string? _processingStatus;
    private string? _error;
    private int? _previewMemberId;
    private ExportOutcome? _result;
    private bool _dataChanged;

    private record PreviousExport(string Reference, DateTime? ExportedAt, int Count, decimal Sum);
    private record ResultLine(string Level, string Text);
    private record ExportOutcome(IReadOnlyList<ResultLine> Lines);

    // Notifications only depend on the selection; cache them so rendering does not rebuild every mail body.
    private (string Key, IReadOnlyList<LoanPayoutNotification> Value)? _previewCache;

    protected override void OnInitialized()
    {
        _redownloadReference = GetPreviousExports().FirstOrDefault()?.Reference;
    }

    private List<LoanPaymentPlanEntry> GetExportCandidates() =>
        Entries.Where(e => e.Status != PaymentPlanEntryStatus.Paid
                           && (_includeExported || !e.ExportedAt.HasValue)
                           && SepaExportService.IsExportable(e)).ToList();

    private List<PreviousExport> GetPreviousExports() =>
        Entries.Where(e => !string.IsNullOrEmpty(e.ExportReference))
            .GroupBy(e => e.ExportReference!)
            .Select(g => new PreviousExport(g.Key, g.Max(e => e.ExportedAt), g.Count(), g.Sum(e => e.TotalAmount)))
            .OrderByDescending(x => x.ExportedAt)
            .ToList();

    private DateTime? SelectedExecutionDate => _useFixedExecutionDate ? _fixedExecutionDate.Date : null;

    private Func<LoanPaymentPlanEntry, DateTime> ExecutionDateFor()
    {
        var fixedDate = SelectedExecutionDate;
        var today = DateTime.Today;
        return e => SepaExportService.GetExecutionDate(e, fixedDate, today);
    }

    private IReadOnlyList<LoanPayoutNotification> BuildPreview(List<LoanPaymentPlanEntry> candidates)
    {
        var key = $"{string.Join(',', candidates.Select(e => e.Id))}|{SelectedExecutionDate:yyyy-MM-dd}";
        if (_previewCache?.Key != key)
            _previewCache = (key, PayoutNotificationService.BuildNotifications(candidates, ExecutionDateFor()));
        return _previewCache.Value.Value;
    }

    private void SetMode(bool redownload)
    {
        _redownload = redownload;
        _confirmed = false;
        _error = null;
    }

    private void SetIncludeExported(bool value)
    {
        _includeExported = value;
        _confirmed = false; // the recipient list changed - confirm again
    }

    private bool ValidateExecutionDate()
    {
        if (_useFixedExecutionDate && _fixedExecutionDate.Date < DateTime.Today)
        {
            _error = L["SepaExecutionDateInPast"];
            return false;
        }
        _error = null;
        return true;
    }

    private async Task RequestExport()
    {
        if (!_confirmed || !ValidateExecutionDate()) return;

        if (GetExportCandidates().Any(e => e.ExportedAt.HasValue))
        {
            _showReexportConfirmation = true;
            return;
        }

        await Export();
    }

    private async Task ConfirmReexport()
    {
        _showReexportConfirmation = false;
        await Export();
    }

    private async Task Export()
    {
        var candidates = GetExportCandidates();
        if (candidates.Count == 0) return;

        _isProcessing = true;
        try
        {
            var result = await SepaExport.ExportLoanPaymentsAsync(
                candidates.Select(e => e.Id).ToList(), new SepaExportOptions(SelectedExecutionDate));
            _dataChanged = true;

            await JS.InvokeVoidAsync("downloadFile", result.FileName, Convert.ToBase64String(result.Content), "application/xml");

            // Only notify about payments that actually ended up in the file.
            var notifications = PayoutNotificationService.BuildNotifications(result.Exported, ExecutionDateFor());
            _processingStatus = string.Format(L["SepaSendingMails"], notifications.Count(n => n.HasEmail));
            StateHasChanged();
            var mails = await PayoutNotificationService.SendAsync(notifications);

            var lines = new List<ResultLine>
            {
                new("success", string.Format(L["SepaExportDone"], result.TransactionCount,
                    FormattingService.FormatCurrency(result.ControlSum), result.MessageId)),
                new("success", string.Format(L["SepaMailsSent"], mails.Sent))
            };
            if (result.Skipped.Count > 0)
                lines.Add(new("warning", string.Format(L["SepaExportSkipped"], result.Skipped.Count)));
            if (mails.WithoutEmail.Count > 0)
                lines.Add(new("warning", string.Format(L["SepaMailsWithoutEmail"], string.Join(", ", mails.WithoutEmail))));
            if (mails.OptedOut.Count > 0)
                lines.Add(new("warning", string.Format(L["SepaMailsOptedOut"], string.Join(", ", mails.OptedOut))));
            if (mails.Failed.Count > 0)
                lines.Add(new("danger", string.Format(L["SepaMailsFailed"], string.Join("; ", mails.Failed))));
            _result = new ExportOutcome(lines);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isProcessing = false;
            _processingStatus = null;
        }
    }

    /// <summary>Rebuilds an earlier export file. Does not mark payments and does not send any mail.</summary>
    private async Task Redownload()
    {
        if (string.IsNullOrEmpty(_redownloadReference) || !ValidateExecutionDate()) return;

        _isProcessing = true;
        try
        {
            var result = await SepaExport.RebuildExportAsync(_redownloadReference, new SepaExportOptions(SelectedExecutionDate));
            await JS.InvokeVoidAsync("downloadFile", result.FileName, Convert.ToBase64String(result.Content), "application/xml");
            _result = new ExportOutcome(new[]
            {
                new ResultLine("success", string.Format(L["SepaRedownloadDone"], result.MessageId, result.TransactionCount,
                    FormattingService.FormatCurrency(result.ControlSum)))
            });
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private Task Close() => _dataChanged ? OnComplete.InvokeAsync() : OnCancel.InvokeAsync();
}
