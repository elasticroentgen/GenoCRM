@page "/loan-repayments"
@using GenoCRM.Models.Domain
@using GenoCRM.Services.Business
@using Microsoft.AspNetCore.Authorization
@using GenoCRM.Services.Localization
@using GenoCRM.Services.UI
@attribute [Authorize]
@inject ILoanPaymentPlanService PaymentPlanService
@inject IStringLocalizer<GenoCRM.SharedResource> L
@inject IFormattingService FormattingService
@inject IModalService ModalService
@inject ISepaExportService SepaExportService
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>@L["RepaymentDashboard"]</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">@L["RepaymentDashboard"]</h1>
    <div class="d-flex gap-2">
        <button class="btn btn-primary" @onclick="() => _showExport = !_showExport" disabled="@_processing">
            <i class="fas fa-file-export"></i> @L["SepaExport"]
        </button>
        <button class="btn btn-outline-secondary" @onclick="RegeneratePlans" disabled="@_processing"
                title="@L["RegeneratePaymentPlansHint"]">
            <i class="fas fa-sync-alt"></i> @L["RegeneratePaymentPlans"]
        </button>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-3">
        <label class="form-label">@L["SelectYear"]</label>
        <select class="form-select" @bind="_selectedYear" @bind:after="LoadEntries">
            @for (int y = _minYear; y <= _maxYear; y++)
            {
                <option value="@y">@y</option>
            }
        </select>
    </div>
</div>

@if (_loading)
{
    <div class="text-center">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else if (_entries != null)
{
    var openEntries = _entries.Where(e => e.Status != PaymentPlanEntryStatus.Paid).ToList();
    var exportCandidates = GetExportCandidates();

    @if (_showExport)
    {
        <div class="card mb-4 border-primary">
            <div class="card-header bg-primary text-white">
                <i class="fas fa-university"></i> @L["SepaExportTitle"] @_selectedYear
            </div>
            <div class="card-body">
                @if (!SepaExportService.Debtor.IsConfigured)
                {
                    <div class="alert alert-warning mb-0">
                        <i class="fas fa-exclamation-triangle"></i> @L["SepaDebtorNotConfigured"]
                    </div>
                }
                else
                {
                    <p class="mb-3">
                        <strong>@L["SepaDebtorAccount"]:</strong>
                        @SepaExportService.Debtor.Name · @SepaExportService.Debtor.Iban
                        @if (!string.IsNullOrWhiteSpace(SepaExportService.Debtor.Bic))
                        {
                            <span> · @SepaExportService.Debtor.Bic</span>
                        }
                    </p>
                    <div class="row g-3 align-items-end">
                        <div class="col-md-4">
                            <label class="form-label">@L["SepaExecutionDate"]</label>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" id="execDue" name="execMode"
                                       checked="@(!_useFixedExecutionDate)" @onchange="() => _useFixedExecutionDate = false" />
                                <label class="form-check-label" for="execDue">@L["SepaExecutionDateDue"]</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" id="execFixed" name="execMode"
                                       checked="@_useFixedExecutionDate" @onchange="() => _useFixedExecutionDate = true" />
                                <label class="form-check-label" for="execFixed">@L["SepaExecutionDateFixed"]</label>
                            </div>
                            @if (_useFixedExecutionDate)
                            {
                                <input type="date" class="form-control mt-1" @bind="_fixedExecutionDate" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                            }
                        </div>
                        <div class="col-md-4">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="includeExported" @bind="_includeExported" />
                                <label class="form-check-label" for="includeExported">@L["SepaIncludeExported"]</label>
                            </div>
                        </div>
                        <div class="col-md-4 text-md-end">
                            <div class="mb-2">
                                <strong>@exportCandidates.Count</strong> @L["Payments"] ·
                                <strong>@FormattingService.FormatCurrency(exportCandidates.Sum(e => e.TotalAmount))</strong>
                            </div>
                            <button class="btn btn-primary" @onclick="ExportSepa" disabled="@(_processing || exportCandidates.Count == 0)">
                                @if (_processing)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                }
                                <i class="fas fa-download"></i> @L["SepaCreateFile"]
                            </button>
                        </div>
                    </div>
                    <small class="text-muted d-block mt-3">@L["SepaExportHint"]</small>
                }
            </div>
        </div>
    }

    <div class="row mb-4 g-3">
        <div class="col-md">
            <div class="card text-center h-100">
                <div class="card-body">
                    <h6 class="card-title text-muted">@L["TotalAmount"]</h6>
                    <h3 class="text-primary">@FormattingService.FormatCurrency(_entries.Sum(e => e.TotalAmount))</h3>
                </div>
            </div>
        </div>
        <div class="col-md">
            <div class="card text-center h-100">
                <div class="card-body">
                    <h6 class="card-title text-muted">@L["TotalInterest"]</h6>
                    <h3 class="text-success">@FormattingService.FormatCurrency(_entries.Sum(e => e.InterestAmount))</h3>
                </div>
            </div>
        </div>
        <div class="col-md">
            <div class="card text-center h-100">
                <div class="card-body">
                    <h6 class="card-title text-muted">@L["TotalPrincipal"]</h6>
                    <h3>@FormattingService.FormatCurrency(_entries.Sum(e => e.PrincipalAmount))</h3>
                </div>
            </div>
        </div>
        <div class="col-md">
            <div class="card text-center h-100">
                <div class="card-body">
                    <h6 class="card-title text-muted">@L["NumberOfPayments"]</h6>
                    <h3>@_entries.Count</h3>
                    <small class="text-muted">@openEntries.Count @L["Open"] · @(_entries.Count - openEntries.Count) @L["Paid"]</small>
                </div>
            </div>
        </div>
        <div class="col-md">
            <div class="card text-center h-100">
                <div class="card-body">
                    <h6 class="card-title text-muted">@L["OpenAmount"]</h6>
                    <h3 class="text-warning">@FormattingService.FormatCurrency(openEntries.Sum(e => e.TotalAmount))</h3>
                    @if (openEntries.Count > 0)
                    {
                        <button class="btn btn-sm btn-success mt-1" @onclick="MarkAllAsPaid" disabled="@_processing">
                            @if (_processing)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            <i class="fas fa-check-double"></i> @L["MarkAllAsPaid"]
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (_entries.Count == 0)
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle"></i> @L["NoEntriesForYear"]
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 2rem;"></th>
                        <th>@L["DueDate"]</th>
                        <th>@L["Member"]</th>
                        <th>@L["SubscriptionNumber"]</th>
                        <th>@L["BankDetails"]</th>
                        <th>@L["TransactionDescription"]</th>
                        <th>@L["PaymentType"]</th>
                        <th class="text-end">@L["Amount"]</th>
                        <th>@L["Status"]</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in _entries)
                    {
                        var sub = entry.LoanPaymentPlan.LoanSubscription;
                        var member = sub.Member;
                        var offer = sub.LoanOffer;
                        var isCombined = entry.PrincipalAmount > 0 && entry.InterestAmount > 0;
                        var expanded = _expanded.Contains(entry.Id);
                        <tr class="@GetRowClass(entry.Status)">
                            <td>
                                @if (isCombined)
                                {
                                    <button class="btn btn-sm btn-link p-0" @onclick="() => ToggleExpanded(entry.Id)"
                                            title="@L["ShowDetails"]">
                                        <i class="fas @(expanded ? "fa-chevron-down" : "fa-chevron-right")"></i>
                                    </button>
                                }
                            </td>
                            <td>@FormattingService.FormatDate(entry.DueDate)</td>
                            <td>
                                <a href="/members/@member.Id">@member.FullName</a>
                                <br /><small class="text-muted">@member.MemberNumber</small>
                            </td>
                            <td>
                                <a href="/loan-subscriptions/@sub.Id">@sub.SubscriptionNumber</a>
                                <br /><small class="text-muted">@offer.Title · @FormatRate(offer.InterestRate)</small>
                            </td>
                            <td>
                                <small>
                                    @sub.BankAccountHolder<br />
                                    @sub.IBAN
                                    @if (!string.IsNullOrWhiteSpace(sub.BIC))
                                    {
                                        <br />@sub.BIC
                                    }
                                </small>
                            </td>
                            <td>
                                @GenoCRM.Services.Business.SepaExportService.GetRemittanceInformation(entry)
                                @if (!isCombined && entry.InterestAmount > 0)
                                {
                                    <br /><small class="text-muted">@FormatInterestPeriod(entry)</small>
                                }
                            </td>
                            <td>
                                @if (isCombined)
                                {
                                    <span class="badge bg-primary">@L["PrincipalAndInterest"]</span>
                                }
                                else if (entry.PrincipalAmount > 0)
                                {
                                    <span class="badge bg-secondary">@L["PrincipalOnly"]</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">@L["InterestOnly"]</span>
                                }
                            </td>
                            <td class="text-end fw-bold">@FormattingService.FormatCurrency(entry.TotalAmount)</td>
                            <td>
                                <span class="badge bg-@GetStatusColor(entry.Status)">
                                    @GetLocalizedStatus(entry.Status)
                                </span>
                                @if (entry.PaidDate.HasValue)
                                {
                                    <br /><small class="text-muted">@FormattingService.FormatDate(entry.PaidDate)</small>
                                }
                                @if (entry.ExportedAt.HasValue)
                                {
                                    <br /><small class="text-muted" title="@entry.ExportReference">
                                        <i class="fas fa-file-export"></i> @L["ExportedAt"] @FormattingService.FormatDate(entry.ExportedAt)
                                    </small>
                                }
                            </td>
                            <td>
                                @if (entry.Status != PaymentPlanEntryStatus.Paid)
                                {
                                    <button class="btn btn-sm btn-outline-success" @onclick="() => MarkAsPaid(entry.Id)" disabled="@_processing"
                                            title="@L["MarkAsPaid"]">
                                        <i class="fas fa-check"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                        @if (isCombined && expanded)
                        {
                            <tr class="table-light">
                                <td></td>
                                <td colspan="5" class="ps-4 small">
                                    <i class="fas fa-level-up-alt fa-rotate-90 text-muted me-2"></i>@L["Principal"]
                                </td>
                                <td><span class="badge bg-secondary">@L["Principal"]</span></td>
                                <td class="text-end small">@FormattingService.FormatCurrency(entry.PrincipalAmount)</td>
                                <td colspan="2"></td>
                            </tr>
                            <tr class="table-light">
                                <td></td>
                                <td colspan="5" class="ps-4 small">
                                    <i class="fas fa-level-up-alt fa-rotate-90 text-muted me-2"></i>@L["Interest"]
                                    <span class="text-muted ms-2">@FormatInterestPeriod(entry)</span>
                                </td>
                                <td><span class="badge bg-success">@L["Interest"]</span></td>
                                <td class="text-end small">@FormattingService.FormatCurrency(entry.InterestAmount)</td>
                                <td colspan="2"></td>
                            </tr>
                        }
                    }
                </tbody>
                <tfoot>
                    <tr class="fw-bold">
                        <td></td>
                        <td colspan="6">@L["TotalInterest"]</td>
                        <td class="text-end">@FormattingService.FormatCurrency(_entries.Sum(e => e.InterestAmount))</td>
                        <td colspan="2"></td>
                    </tr>
                    <tr class="fw-bold">
                        <td></td>
                        <td colspan="6">@L["TotalPrincipal"]</td>
                        <td class="text-end">@FormattingService.FormatCurrency(_entries.Sum(e => e.PrincipalAmount))</td>
                        <td colspan="2"></td>
                    </tr>
                    <tr class="table-dark fw-bold">
                        <td></td>
                        <td colspan="6">@L["TotalAmount"]</td>
                        <td class="text-end">@FormattingService.FormatCurrency(_entries.Sum(e => e.TotalAmount))</td>
                        <td colspan="2"></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    }
}

@code {
    private int _selectedYear = DateTime.Today.Year;
    private int _minYear = DateTime.Today.Year;
    private int _maxYear = DateTime.Today.Year + 10;
    private List<LoanPaymentPlanEntry>? _entries;
    private readonly HashSet<int> _expanded = new();
    private bool _loading;
    private bool _processing;
    private bool _showExport;
    private bool _includeExported;
    private bool _useFixedExecutionDate;
    private DateTime _fixedExecutionDate = DateTime.Today.AddDays(1);

    protected override async Task OnInitializedAsync()
    {
        await LoadYearRange();
        await LoadEntries();
    }

    private async Task LoadYearRange()
    {
        var range = await PaymentPlanService.GetPaymentYearRangeAsync();
        var currentYear = DateTime.Today.Year;
        _minYear = Math.Min(range?.MinYear ?? currentYear, currentYear);
        _maxYear = Math.Max(range?.MaxYear ?? currentYear + 10, currentYear);
        _selectedYear = Math.Clamp(_selectedYear, _minYear, _maxYear);
    }

    private async Task LoadEntries()
    {
        _loading = true;
        _expanded.Clear();
        StateHasChanged();
        try
        {
            _entries = await PaymentPlanService.GetEntriesByYearAsync(_selectedYear);
        }
        finally
        {
            _loading = false;
        }
    }

    private void ToggleExpanded(int entryId)
    {
        if (!_expanded.Remove(entryId)) _expanded.Add(entryId);
    }

    private async Task MarkAsPaid(int entryId)
    {
        _processing = true;
        try
        {
            await PaymentPlanService.MarkEntryAsPaidAsync(entryId);
            await LoadEntries();
        }
        catch (Exception ex)
        {
            await ModalService.ShowErrorAsync(L["Error"], ex.Message);
        }
        finally
        {
            _processing = false;
        }
    }

    private async Task MarkAllAsPaid()
    {
        var confirmed = await ModalService.ShowConfirmationAsync(
            L["MarkAllAsPaid"],
            L["MarkAllAsPaidConfirm"]);
        if (!confirmed) return;

        _processing = true;
        try
        {
            foreach (var entry in _entries!.Where(e => e.Status != PaymentPlanEntryStatus.Paid).ToList())
            {
                await PaymentPlanService.MarkEntryAsPaidAsync(entry.Id);
            }
            await LoadEntries();
        }
        catch (Exception ex)
        {
            await ModalService.ShowErrorAsync(L["Error"], ex.Message);
        }
        finally
        {
            _processing = false;
        }
    }

    private List<LoanPaymentPlanEntry> GetExportCandidates() =>
        _entries?.Where(e => e.Status != PaymentPlanEntryStatus.Paid
                             && (_includeExported || !e.ExportedAt.HasValue)
                             && GenoCRM.Services.Business.SepaExportService.IsExportable(e)).ToList()
        ?? new List<LoanPaymentPlanEntry>();

    private async Task ExportSepa()
    {
        var candidates = GetExportCandidates();
        if (candidates.Count == 0) return;
        if (_useFixedExecutionDate && _fixedExecutionDate.Date < DateTime.Today)
        {
            await ModalService.ShowErrorAsync(L["Error"], L["SepaExecutionDateInPast"]);
            return;
        }

        if (candidates.Any(e => e.ExportedAt.HasValue))
        {
            var confirmed = await ModalService.ShowConfirmationAsync(L["SepaExport"], L["SepaReexportConfirm"]);
            if (!confirmed) return;
        }

        _processing = true;
        try
        {
            var result = await SepaExportService.ExportLoanPaymentsAsync(
                candidates.Select(e => e.Id).ToList(),
                new SepaExportOptions(_useFixedExecutionDate ? _fixedExecutionDate.Date : null));

            await JS.InvokeVoidAsync("downloadFile", result.FileName, Convert.ToBase64String(result.Content), "application/xml");
            await LoadEntries();

            var message = string.Format(L["SepaExportDone"], result.TransactionCount,
                FormattingService.FormatCurrency(result.ControlSum), result.MessageId);
            if (result.Skipped.Count > 0)
                message += " " + string.Format(L["SepaExportSkipped"], result.Skipped.Count);
            await ModalService.ShowSuccessAsync(L["SepaExport"], message);
        }
        catch (Exception ex)
        {
            await ModalService.ShowErrorAsync(L["Error"], ex.Message);
        }
        finally
        {
            _processing = false;
        }
    }

    private async Task RegeneratePlans()
    {
        var confirmed = await ModalService.ShowConfirmationAsync(
            L["RegeneratePaymentPlans"],
            L["RegeneratePaymentPlansConfirm"]);
        if (!confirmed) return;

        _processing = true;
        try
        {
            var count = await PaymentPlanService.RegeneratePaymentPlansAsync();
            await LoadYearRange();
            await LoadEntries();
            await ModalService.ShowSuccessAsync(L["RegeneratePaymentPlans"],
                string.Format(L["RegeneratePaymentPlansDone"], count));
        }
        catch (Exception ex)
        {
            await ModalService.ShowErrorAsync(L["Error"], ex.Message);
        }
        finally
        {
            _processing = false;
        }
    }

    private string FormatInterestPeriod(LoanPaymentPlanEntry entry)
    {
        if (entry.InterestPeriodStart is not { } start || entry.InterestPeriodEnd is not { } end)
            return string.Empty;
        return $"{FormattingService.FormatDate(start)} – {FormattingService.FormatDate(end.AddDays(-1))} " +
               $"({entry.InterestDays} {L["Days"]}, {FormatRate(entry.LoanPaymentPlan.LoanSubscription.LoanOffer.InterestRate)})";
    }

    private static string FormatRate(decimal rate) => $"{rate * 100:F2} %";

    private static string GetRowClass(PaymentPlanEntryStatus status) => status switch
    {
        PaymentPlanEntryStatus.Paid => "table-success",
        PaymentPlanEntryStatus.Overdue => "table-danger",
        _ => ""
    };

    private static string GetStatusColor(PaymentPlanEntryStatus status) => status switch
    {
        PaymentPlanEntryStatus.Pending => "warning",
        PaymentPlanEntryStatus.Due => "info",
        PaymentPlanEntryStatus.Paid => "success",
        PaymentPlanEntryStatus.Overdue => "danger",
        _ => "secondary"
    };

    private string GetLocalizedStatus(PaymentPlanEntryStatus status) => status switch
    {
        PaymentPlanEntryStatus.Pending => L["Pending"],
        PaymentPlanEntryStatus.Due => L["Due"],
        PaymentPlanEntryStatus.Paid => L["Paid"],
        PaymentPlanEntryStatus.Overdue => L["Overdue"],
        _ => status.ToString()
    };
}
